# JusLegis — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou defina na Vercel (Settings → Environment Variables).
# NUNCA versione valores reais. Variáveis sem NEXT_PUBLIC_ ficam somente no servidor.

# URL pública da aplicação (usada nos redirecionamentos de login e no retorno do checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────
# Públicas (protegidas por RLS no banco)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta — somente servidor. Usada para testes de conexão, webhooks e leitura das configurações administrativas.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (somente servidor) ────────────────────────────
OPENAI_API_KEY=

# ── Mercado Pago PJ (somente servidor) ───────────────────
# Ambiente ativo: test | prod. Mantenha "test" até validar o fluxo completo.
MP_ENVIRONMENT=test
MP_ACCESS_TOKEN_TEST=
MP_ACCESS_TOKEN_PROD=
MP_WEBHOOK_SECRET=
# Trava de segurança: enquanto não for exatamente "true", nenhum checkout é criado e nenhuma cobrança é iniciada.
BILLING_ENABLED=false

# A pesquisa jurídica usa OPENAI_API_KEY e fica desabilitada até habilitação no Admin Geral.
# Não há chave de fornecedor jurídico independente nesta etapa.
