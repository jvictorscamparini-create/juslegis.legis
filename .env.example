# JusLegis — variáveis de ambiente (sem valores secretos)
# Variáveis sem NEXT_PUBLIC_ ficam somente no servidor. Nunca versione valores reais.
# Vercel: defina as variáveis Supabase em Preview E Production; segredos nunca com prefixo NEXT_PUBLIC_.

# Projeto Supabase dedicado: https://hbqlwwnnbvritknwwzos.supabase.co (NÃO usar odoavqqihukvpsmvopvf)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URLs usadas em redirects (login, OAuth, retorno do checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (somente servidor; modelo padrão, sobrescrevível pelo Admin)
OPENAI_API_KEY=
OPENAI_MODEL=

# Mercado Pago — apenas Sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=sandbox
# Trava: checkout só é criado quando exatamente "true". Mantenha false.
BILLING_ENABLED=false

# DataJud/CNJ — sem estas variáveis a UI mostra "Consulta ainda não configurada"
DATAJUD_API_URL=
DATAJUD_API_KEY=

# Chave mestra que cifra as credenciais salvas pelo painel do Administrador Geral (Integrações e APIs).
# Gere uma vez e guarde só na Vercel (Preview e Production, como secreta; nunca NEXT_PUBLIC_):
#   openssl rand -base64 32
# Sem ela o painel não grava chaves e continuam valendo as variáveis de ambiente.
# Atenção: se esta chave for trocada ou perdida, as credenciais salvas no painel precisam ser informadas de novo.
APP_SECRETS_KEY=
