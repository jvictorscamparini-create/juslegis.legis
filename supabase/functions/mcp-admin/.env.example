# Opcional. Sem estas variáveis a função usa os valores padrão abaixo.
# Elas ficam no mesmo arquivo supabase/functions/.env da função "mcp" (fora do git) e vão com:
#   supabase secrets set --env-file supabase/functions/.env
# O Supabase fornece sozinho a URL do projeto e as chaves de API à função. Não há service role aqui.

MCP_ADMIN_SERVER_NAME=juslegis-admin-mcp
MCP_ADMIN_SERVER_DESCRIPTION="Ferramentas do Administrador Geral da JusLegis: configurações do site, prompts da IA, usuários e log de auditoria."
