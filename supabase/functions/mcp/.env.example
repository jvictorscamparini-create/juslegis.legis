# Copie para supabase/functions/.env antes de servir localmente:
#   cp supabase/functions/mcp/.env.example supabase/functions/.env
#   supabase functions serve mcp --env-file supabase/functions/.env
#
# Para publicar (depois de vincular o projeto hbqlwwnnbvritknwwzos):
#   supabase secrets set --env-file supabase/functions/.env
# O Supabase fornece sozinho a URL do projeto e as chaves de API à função.

MCP_SERVER_NAME=juslegis-mcp
MCP_SERVER_DESCRIPTION="Acesso somente leitura ao workspace do advogado autenticado na JusLegis: casos, petições, documentos e conversas. Todas as ferramentas rodam como o usuário logado."
